# Nginx: HTTPS-прокси к Docker-приложению (порт 3001).
# Установка на Ubuntu VPS:
#   apt install -y nginx certbot python3-certbot-nginx
#   cp docker/nginx/ekvaline.conf.example /etc/nginx/sites-available/ekvaline
#   nano /etc/nginx/sites-available/ekvaline   # замените ekvaline.ru на ваш домен
#   ln -sf /etc/nginx/sites-available/ekvaline /etc/nginx/sites-enabled/
#   nginx -t && systemctl reload nginx
#   certbot --nginx -d ekvaline.ru -d www.ekvaline.ru
#
# В .env на сервере после HTTPS:
#   APP_BASE_URL=https://ekvaline.ru
#   USE_SECURE_COOKIES=true
#   docker compose restart app
#
# Рекомендация: в docker-compose.yml привязать app только к localhost:
#   ports: ['127.0.0.1:3001:3001']

upstream ekvaline_app {
    server 127.0.0.1:3001;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name ekvaline.ru www.ekvaline.ru;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ekvaline.ru www.ekvaline.ru;

    # certbot заполнит пути после: certbot --nginx -d ekvaline.ru
    ssl_certificate     /etc/letsencrypt/live/ekvaline.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ekvaline.ru/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    client_max_body_size 10m;

    location / {
        proxy_pass http://ekvaline_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 120s;
        add_header Cache-Control "no-store, must-revalidate" always;
    }
}
