# Скопируйте в .env перед: docker compose up --build
# cp .env.docker.example .env
# Проверка: npm run deploy:check
# Инструкция: docs/ВЫКЛАДКА-GIT-И-VPS.md | Чек-лист: docs/ЧЕКЛИСТ-ПЕРЕД-ВЫКЛАДКОЙ.md

NODE_ENV=production
PORT=3001

# Минимум 32 символа (обязательно). На сервере: openssl rand -hex 24
SESSION_SECRET=

# true — только при HTTPS (nginx + Let's Encrypt). При http://IP:3001 оставьте закомментированным.
# USE_SECURE_COOKIES=true

# Таймаут бездействия (минуты), после — повторный вход. По умолчанию 30.
# SESSION_IDLE_MINUTES=30

# В docker-compose DATABASE_URL задаётся автоматически (хост db).
# Локально без Docker:
# DATABASE_URL=postgres://ekvaline:ekvaline@localhost:5432/ekvaline

# JavaScript API (карта в браузере) + HTTP Геокодер (поиск адреса на сервере)
YANDEX_MAPS_API_KEY=b7c84c0c-5952-4525-8611-45602688bfb8
YANDEX_GEOCODER_API_KEY=eec71376-cee9-42be-9cf7-ba99c96a4db6

# SMTP обязателен в production (регистрация, коды, сброс пароля клиентов)
# Подробнее: docs/НАСТРОЙКА-ПОЧТЫ.md
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ЭкваЛайн <noreply@example.ru>

# IP сервера или домен с https:// после настройки SSL
APP_BASE_URL=http://ВАШ_IP:3001

# Демо-заказы при старте — только для тестов, на боевом сайте не включать
# SEED_DEMO_ORDERS=0

# Код для смены/просмотра сведений о пароле сотрудника в админке
# ADMIN_STAFF_PASSWORD_GATE=295302
