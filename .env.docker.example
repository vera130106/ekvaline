# Скопируйте в .env перед: docker compose up --build
# cp .env.docker.example .env
# Инструкция выкладки на сервер: docs/ВЫКЛАДКА-GIT-И-VPS.md

NODE_ENV=production
PORT=3001

# Минимум 32 символа (обязательно). Пример — замените на свой:
SESSION_SECRET=change-me-use-openssl-rand-hex-32-characters-min

# В docker-compose DATABASE_URL задаётся автоматически (хост db).
# Локально без Docker:
# DATABASE_URL=postgres://ekvaline:ekvaline@localhost:5432/ekvaline

YANDEX_MAPS_API_KEY=
YANDEX_GEOCODER_API_KEY=

# SMTP для подтверждения email и смены пароля (заполните для реальной почты)
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ЭкваЛайн <noreply@example.ru>
APP_BASE_URL=http://localhost:3001
