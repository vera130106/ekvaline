# Скопируйте в .env перед: docker compose up --build
# cp .env.docker.example .env

NODE_ENV=production
PORT=3001

# Минимум 32 символа (обязательно). Пример — замените на свой:
SESSION_SECRET=change-me-use-openssl-rand-hex-32-characters-min

# В docker-compose DATABASE_URL задаётся автоматически (хост db).
# Локально без Docker:
# DATABASE_URL=postgres://ekvaline:ekvaline@localhost:5432/ekvaline

YANDEX_MAPS_API_KEY=
