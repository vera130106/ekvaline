# Обязательно в production (минимум 32 символа). Без этого сервер не запустится при NODE_ENV=production.
SESSION_SECRET=

# Бездействие пользователя (минуты): после этого сессия завершается, нужен повторный вход. По умолчанию 30.
# SESSION_IDLE_MINUTES=30

# Яндекс.Карты — два ключа в кабинете developer.tech.yandex.ru:
# 1) JavaScript API — отображение карты (оформление заказа, оператор, доставка)
YANDEX_MAPS_API_KEY=
# 2) HTTP API Геокодера — поиск адреса и обратное геокодирование на сервере
YANDEX_GEOCODER_API_KEY=

# Демо-заказы (~100/день) при старте сервера: 1 или true. По умолчанию выключено.
# SEED_DEMO_ORDERS=0

# PostgreSQL (обязательно без Docker)
# DATABASE_URL=postgres://ekvaline:ekvaline@localhost:5432/ekvaline

# Почта: коды подтверждения email и смены пароля (обязательно для production)
# Mail.ru: SMTP_HOST=smtp.mail.ru, PORT=465, SECURE=1
# Yandex: SMTP_HOST=smtp.yandex.ru, PORT=465, SECURE=1
# Gmail: SMTP_HOST=smtp.gmail.com, PORT=587, SECURE=0 + пароль приложения
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ЭкваЛайн <noreply@example.ru>
APP_BASE_URL=http://localhost:3000

# Docker: cp .env.docker.example .env && npm run docker:up
# Сайт: http://localhost:3001
